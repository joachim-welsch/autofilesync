[Unit]
Description=AutoFileSync background synchronisation
Wants=network-online.target remote-fs.target
After=network-online.target remote-fs.target
ConditionPathExists=/etc/systemd/system/backgroundsync.service.d/user.conf

[Service]
ExecStartPre=/usr/lib/autofilesync/wait-network-mounts
ExecStart=/usr/sbin/backgroundsync
Restart=on-failure
# The daemon needs no privileges beyond the user's own and never writes below
# /usr, /boot, /efi or /etc. Not ProtectHome or PrivateTmp: the configuration
# and the sync trees live in the user's home, and a target may be anywhere.
NoNewPrivileges=yes
ProtectSystem=full
WorkingDirectory=~
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backgroundsync

[Install]
WantedBy=multi-user.target

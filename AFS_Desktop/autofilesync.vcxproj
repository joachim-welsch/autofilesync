  <!-- IncrementalClean (part of the built-in Build target) runs right after PostBuildEvent
       and deletes any output-folder file it doesn't recognize as a declared build output -
       including files a PostBuildEvent just copied in, which is why libssh2/llama/ggml/ssl
       DLLs vanished right after being copied. AfterTargets="Build" runs once IncrementalClean
       is done, so the copied files survive. -->
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <Exec Command="call &quot;$(ProjectDir)copy_libssh2.bat&quot; $(ConfigurationName) &quot;$(OutDir)&quot;" />
    <Exec Command="xcopy /Y /I /E &quot;$(ProjectDir)help&quot; &quot;$(OutDir)help&quot;" />
  </Target>

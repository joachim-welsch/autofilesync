{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/autofilesync",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/usr/local/lib:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu"
                },
                {
                    "name": "LD_PRELOAD",
                    "value": ""
                },
                {
                    "name": "GTK_MODULES",
                    "value": ""
                },
                {
                    "name": "GTK_PATH",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "console": "integratedTerminal",
            "terminal": "integratedTerminal",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod prompt",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build",
            "logging": {
                "engineLogging": true,
                "trace": false,
                "traceResponse": false
            },
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}

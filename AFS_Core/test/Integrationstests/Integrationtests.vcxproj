  </ImportGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <VcpkgUseStatic>false</VcpkgUseStatic>
  </PropertyGroup>
  <!-- Explizite vcpkg-Pfade als Rueckfallebene zur MSBuild-Integration.
       WICHTIG: keine Exists()-Bedingungen - PropertyGroups werden beim Laden
       des Projekts ausgewertet, also bevor der vcpkg-Install-Schritt im Build
       das Verzeichnis ueberhaupt angelegt hat. Beide Layouts werden eingetragen
       (VS-Integration verdoppelt den Triplet-Ordner, die CLI nicht); nicht
       existierende Include-Pfade ignoriert cl.exe folgenlos. -->
  <PropertyGroup Label="VcpkgPaths">
    <VcpkgManifestInstall>true</VcpkgManifestInstall>
    <VcpkgManifestDir>$(MSBuildProjectDirectory)\vcpkg_installed\$(VcpkgTriplet)</VcpkgManifestDir>
    <VcpkgIncludeDirCli>$(VcpkgManifestDir)\include</VcpkgIncludeDirCli>
    <VcpkgIncludeDirIde>$(VcpkgManifestDir)\$(VcpkgTriplet)\include</VcpkgIncludeDirIde>
    <VcpkgLibSuffix Condition="'$(Configuration)' == 'Debug'">debug\lib</VcpkgLibSuffix>
    <VcpkgLibSuffix Condition="'$(Configuration)' != 'Debug'">lib</VcpkgLibSuffix>
    <VcpkgLibDirCli>$(VcpkgManifestDir)\$(VcpkgLibSuffix)</VcpkgLibDirCli>
    <VcpkgLibDirIde>$(VcpkgManifestDir)\$(VcpkgTriplet)\$(VcpkgLibSuffix)</VcpkgLibDirIde>
  </PropertyGroup>
  <!-- llama.cpp und ggml fehlen im Manifest: vcpkg wuerde llama.cpp dafuer komplett
       neu bauen. Sie kommen wie bei run_GUI_Tests.ps1 aus dem globalen Package-Ordner. -->
  <PropertyGroup Label="LlamaPaths">
    <VcpkgPackagesDir Condition="'$(VcpkgPackagesDir)' == ''">C:\Entwicklung\extlib\vcpkg\packages</VcpkgPackagesDir>
    <LlamaPkgDir>$(VcpkgPackagesDir)\llama-cpp_x64-windows</LlamaPkgDir>
    <GgmlPkgDir>$(VcpkgPackagesDir)\ggml_x64-windows</GgmlPkgDir>
    <LlamaCfgDir Condition="'$(Configuration)' == 'Debug'">debug\</LlamaCfgDir>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <TargetName>Integrationtests</TargetName>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>

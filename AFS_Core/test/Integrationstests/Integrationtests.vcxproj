  <!-- ==========================================================
       Pfade werden aus der Projektlage abgeleitet, NICHT aus %USERPROFILE%.
       Erwartete Struktur:
         <Repo>\AFS_Core\              <- LibDir
         <Repo>\AFS_Core\test\Integrationstests <- dieses Projekt
       Abweichung: LibDir hier hart setzen oder per
       msbuild /p:LibDir=D:\pfad\AFS_Core uebergeben.
       ========================================================== -->
  <PropertyGroup Label="UserPaths">
    <LibDir Condition="'$(LibDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</LibDir>
    <!-- Vorwaertsslashes fuer das String-Literal LIB_SOURCE_DIR -->
    <LibDirPosix>$(LibDir.Replace('\','/'))</LibDirPosix>
    <!-- Boost kommt normalerweise ueber vcpkg (boost-property-tree im Manifest);
         die Include-Pfade setzt die vcpkg-Integration dann selbst.
         Nur fuer eine manuell installierte Boost-Distribution hier oder per
         Umgebungsvariable BoostRoot den Wurzelpfad setzen, z.B.
         C:\Entwicklung\extlib\boost_1_87_0 -->
    <BoostRoot Condition="'$(BoostRoot)' == '' and '$(BOOST_ROOT)' != ''">$(BOOST_ROOT)</BoostRoot>
    <BoostIncludeDir Condition="'$(BoostRoot)' != ''">$(BoostRoot)</BoostIncludeDir>
    <BoostLibDir Condition="'$(BoostRoot)' != '' and Exists('$(BoostRoot)\stage\lib')">$(BoostRoot)\stage\lib</BoostLibDir>
    <BoostLibDir Condition="'$(BoostLibDir)' == '' and '$(BoostRoot)' != '' and Exists('$(BoostRoot)\lib64-msvc-14.3')">$(BoostRoot)\lib64-msvc-14.3</BoostLibDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />

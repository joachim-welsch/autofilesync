  <!-- ===================== Gemeinsame Compilereinstellungen ===================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>C:\Entwicklung\extlib\boost_1_91_0;$(ProjectDir);$(LibDir);$(LibDir)\include;$(VcpkgIncludeDirCli);$(VcpkgIncludeDirIde);$(LlamaPkgDir)\include;$(GgmlPkgDir)\include;$(BoostIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- _CRT_SECURE_NO_WARNINGS / _SCL_SECURE_NO_WARNINGS werden bereits in
           pch.h gesetzt -> hier weglassen, sonst C4005 (Makro-Neudefinition).
           Deprecation-Warnungen sind ueber DisableSpecificWarnings 4996 abgedeckt. -->
      <PreprocessorDefinitions>WIN32;_WINDOWS;_TEST;NOMINMAX;WIN32_LEAN_AND_MEAN;LIB_SOURCE_DIR="$(LibDirPosix)";AFS_WITH_GETTEXT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 4505: static-Funktion in einem Header, in dieser TU ungenutzt (FilesystemUtil).
           5205 (Loeschen abstrakter Klasse ohne virtuellen Dtor) ist bewusst NICHT
           unterdrueckt - das ist ein echter Befund in SyncPath. -->
      <DisableSpecificWarnings>4100;4996;4505;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <!-- Ohne /utf-8 liest MSVC Quellen ohne BOM in der ANSI-Codepage (cp1252),
           obwohl alle Dateien dieses Projekts UTF-8 sind: Umlaut-Literale werden
           dadurch doppelt kodiert ("ä" -> "Ã¤"), was die StrUtil- und
           SyncException-Tests scheitern liess. /utf-8 setzt Quell- UND
           Ausfuehrungszeichensatz auf UTF-8, wie es gcc/clang ohnehin tun. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(VcpkgLibDirCli);$(VcpkgLibDirIde);$(LlamaPkgDir)\$(LlamaCfgDir)lib;$(GgmlPkgDir)\$(LlamaCfgDir)lib;$(BoostLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>gtest.lib;gtest_main.lib;libssh2.lib;libcrypto.lib;ws2_32.lib;crypt32.lib;bcrypt.lib;advapi32.lib;user32.lib;shlwapi.lib;intl.lib;llama.lib;ggml.lib;ggml-cpu.lib;ggml-base.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /y /d "$(LlamaPkgDir)\$(LlamaCfgDir)bin\*.dll" "$(OutDir)" &gt;nul &amp;&amp; xcopy /y /d "$(GgmlPkgDir)\$(LlamaCfgDir)bin\*.dll" "$(OutDir)" &gt;nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

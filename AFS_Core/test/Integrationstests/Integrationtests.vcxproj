  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <!-- vcpkg legt seine DLLs nur im Linkschritt neben die Exe (AppLocalFromInstalled) und
       traegt sie dabei in FileWrites ein. Ein Build ohne Linkschritt kennt sie nicht mehr,
       und IncrementalClean loescht dann alles, was der vorige Build eingetragen hatte:
       jeder zweite Build endete ohne DLLs (STATUS_DLL_NOT_FOUND, 0xC0000135). Deshalb
       werden die im applocal-Log verzeichneten DLLs in jedem Build als FileWrites gemeldet. -->
  <PropertyGroup>
    <IncrementalCleanDependsOn>$(IncrementalCleanDependsOn);KeepVcpkgDlls</IncrementalCleanDependsOn>
  </PropertyGroup>
  <Target Name="KeepVcpkgDlls" Condition="Exists('$(IntDir)vcpkg.applocal.log')">
    <ReadLinesFromFile File="$(IntDir)vcpkg.applocal.log">
      <Output TaskParameter="Lines" ItemName="VcpkgAppLocalDllsKept" />
    </ReadLinesFromFile>
    <ItemGroup>
      <FileWrites Include="@(VcpkgAppLocalDllsKept)" />
    </ItemGroup>
  </Target>
  <!-- Wurden die DLLs von Hand entfernt, holt nur ein neuer Linkschritt sie zurueck. -->
  <Target Name="RelinkWhenVcpkgDllsMissing" BeforeTargets="Link" Condition="Exists('$(TargetPath)') and !Exists('$(OutDir)gtest.dll')">
    <Message Importance="high" Text="vcpkg-DLLs fehlen in $(OutDir): Exe wird neu gelinkt." />
    <Delete Files="$(TargetPath)" />
  </Target>
  <!-- ===================== Pfadpruefung =====================
       Verhindert die Lawine aus C1083-Fehlern: falsche Pfade werden mit
       einer einzigen aussagekraeftigen Meldung abgefangen. -->
  <Target Name="ValidateSourcePaths" BeforeTargets="ClCompile">
    <Message Importance="high" Text="LibDir   = $(LibDir)" />
    <Error Condition="!Exists('$(LibDir)\src\SyncFile.cpp')" Text="LibDir zeigt nicht auf die AFS_Core-Quellen (SyncFile.cpp fehlt): '$(LibDir)'. Property LibDir im .vcxproj anpassen oder /p:LibDir=... uebergeben." />
    <!-- Nur Warnung: ein Error wuerde den Build abbrechen, bevor der
         vcpkg-Install-Schritt Boost ueberhaupt anlegen kann. -->
    <Warning Condition="!Exists('$(VcpkgIncludeDirCli)\boost\version.hpp') and !Exists('$(VcpkgIncludeDirIde)\boost\version.hpp') and '$(BoostIncludeDir)' == ''" Text="Boost liegt (noch) nicht im vcpkg-Baum: weder '$(VcpkgIncludeDirCli)\boost' noch '$(VcpkgIncludeDirIde)\boost' vorhanden. Falls der Build gleich mit C1083 abbricht: vcpkg install von Hand im Projektverzeichnis ausfuehren und dessen Ausgabe pruefen." />
  </Target>
